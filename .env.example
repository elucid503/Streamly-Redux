DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Required for VOD. A per-account Febbox token, roughly a year's lifetime, supplied by hand.
FEBBOX_UI_COOKIE=

# Required for home-page curation and high-quality title artwork.
TMDB_API_KEY=

# Required for subtitles. Without it the subtitle menu stays empty rather than failing.
SUBDL_API_KEY=

# Optional. Skip-intro works anonymously but a season of autoplay is a lot of lookups.
INTRODB_TOKEN=

# Per-server watch history + VOD resume positions.
MONGO_URI=

LISTEN_ADDR=:8080
STATIC_DIR=web/dist

# Bypasses the discordsays.com origin check on /proxy — local testing only.
ALLOW_ANY_ORIGIN=0
